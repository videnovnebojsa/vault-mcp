{
  "name": "vault-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Production-grade MCP server for Obsidian vaults — hybrid search, capture pipeline, backlink-aware operations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:bin": "tsc -p tsconfig.bin.json",
    "start": "node dist/index.js",
    "start:stdio-bridge": "tsx bin/stdio-bridge.ts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:dead": "knip",
    "check:types": "type-coverage --at-least 95"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.1",
    "knip": "^6.12.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.19.4",
    "type-coverage": "^2.29.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
