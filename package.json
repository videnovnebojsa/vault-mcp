{
  "name": "vault-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Production-grade MCP server for Obsidian vaults — hybrid search, capture pipeline, backlink-aware operations",
  "license": "MIT",
  "homepage": "https://thinkink.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/videnovnebojsa/vault-mcp.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bun dist/index.js",
    "start:stdio-bridge": "bun bin/stdio-bridge.ts",
    "dev": "bun src/index.ts",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "test:coverage": "bun test --isolate --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:dead": "knip",
    "check:types": "bun tsc --noEmit",
    "check:types-coverage": "type-coverage --at-least 95 --strict",
    "build:bun": "bun run bunbuild.ts",
    "setup": "bun run scripts/setup.ts",
    "configure": "bun run scripts/configure.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.13",
    "knip": "^6.12.0",
    "lefthook": "^2.1.6",
    "type-coverage": "^2.29.7",
    "typescript": "^5.8.3"
  },
  "knip": {
    "entry": [
      "src/lib.ts"
    ],
    "ignoreDependencies": [
      "@opentelemetry/sdk-node",
      "@opentelemetry/auto-instrumentations-node",
      "@opentelemetry/exporter-trace-otlp-http",
      "@opentelemetry/sdk-trace-node",
      "@opentelemetry/api"
    ],
    "ignoreBinaries": [
      "launchctl",
      "systemctl",
      "schtasks",
      "dist/index.js"
    ]
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "qs": ">=6.15.2",
    "js-yaml": "^4.1.1",
    "_overrides_rationale": "js-yaml pinned to ^4.1.1: transitive deps pull in 3.x which has known CVEs (arbitrary code execution via untrusted YAML). qs pinned to >=6.15.2 to avoid prototype-pollution CVE in older versions."
  }
}
