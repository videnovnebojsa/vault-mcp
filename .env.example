# Required
OBSIDIAN_VAULT_PATH=~/Documents/obsidian   # path to your primary (default) vault

# Optional — additional vaults (multi-vault support)
# VAULT_PATHS=work:/path/to/work-vault;personal:/path/to/personal-vault  (semicolon-separated; safe for paths containing commas)
# Access via: vault_read_note(path="note.md", vault="work")

# Optional — HTTP server
MCP_PORT=3782
MCP_HOST=127.0.0.1
MCP_API_KEY=                               # Bearer token; leave empty for local-only use

# Optional — search index
MEMORY_DB_PATH=                            # default: {vault}/.vault-search.db

# Optional — vector embeddings (requires OpenAI-compatible endpoint)
ENABLE_EMBEDDINGS=false
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=                        # e.g. https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
HYBRID_ALPHA=0.5                           # 0=pure semantic, 1=pure keyword

# Optional — capture pipeline
ENABLE_CAPTURE_PIPELINE=false
LOG_RAW_INPUT=false

# Optional — periodic notes
PERIODIC_NOTES_ROOT=Journal               # root folder for daily/weekly/monthly notes

# Optional — backup
ENABLE_DB_BACKUP=true
DB_BACKUP_DIR=                            # default: {vault}/.vault-backups
DB_BACKUP_MAX_KEEP=5

# Optional — file watcher
ENABLE_FILE_WATCHER=true
FILE_WATCHER_DEBOUNCE_MS=300

# Optional — logging
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=text                           # text | json
ALERT_WEBHOOK_URL=                        # POST alerts to this URL
